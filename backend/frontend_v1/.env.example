# Copiar a .env y completar con valores reales -- nunca commitear .env.
# Estas son variables de BUILD (Vite las inyecta al compilar, ver
# vite.config.ts) -- si las cambiás en Netlify hay que disparar un nuevo
# deploy, no alcanza con reiniciar.

# URL del backend deployado (ej: https://tu-backend.onrender.com) -- sin
# "/" al final. En local queda en http://localhost:3000 si se omite.
VITE_API_URL=

# Supabase (Settings > API en el dashboard del proyecto) -- la ANON key
# publica, NUNCA la service_role (esa es solo del backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
