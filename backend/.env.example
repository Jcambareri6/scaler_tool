# Copiar a .env y completar con valores reales -- nunca commitear .env.

# Supabase (Settings > API en el dashboard del proyecto)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Puerto del servidor -- en Render lo inyecta la plataforma sola, no hace
# falta setearlo a mano ahi.
PORT=3000

# "true" para que las Tools devuelvan datos de prueba en vez de pegarle a
# APIs externas reales (SnapGen, OpenAI, etc.) -- SIEMPRE "false" en
# produccion.
MOCK_PROVIDERS=false

# URL del frontend deployado (ej: https://tu-app.netlify.app) -- sin esto,
# CORS solo deja pasar localhost:8443 (ver src/app.ts) y el frontend de
# produccion no va a poder pegarle a la API.
FRONTEND_ORIGIN=

# "true" para saltear el login en local (no valida token, no hace falta
# mandar Authorization) -- SIEMPRE "false" en produccion. Requiere
# DEV_USER_ID seteado (ver src/middleware/auth.middleware.ts).
DISABLE_AUTH=false

# UUID de un usuario real ya existente en Supabase Auth -- todas las
# requests quedan scopeadas a este usuario cuando DISABLE_AUTH=true.
DEV_USER_ID=
