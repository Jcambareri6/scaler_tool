# Configuracion del worker de render (docker-compose.worker.yml).
# Copiar a .env.worker en el servidor y completar -- nunca commitear .env.worker.

# --- Obligatorio -------------------------------------------------------------
# Los mismos valores que usa la API en Render (Settings > API en Supabase).
# El resto de las credenciales (OpenAI, ai33, Pexels, R2, Cloudinary...) el
# worker las lee de la tabla `providers`, igual que la API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nombre unico y FIJO por servidor (ej: ax42-1, ax42-2). Si el contenedor se
# reinicia con el mismo nombre, recupera al instante los trabajos que dejo a
# medias.
WORKER_ID=ax42-1

# --- Capacidad (valores sugeridos para un Hetzner AX42: 8 nucleos, 64GB) ----
# Renders de ffmpeg en paralelo. Mas de 2 en 8 nucleos no termina mas videos
# por hora, solo los hace mas lentos a todos.
RENDER_CONCURRENCY=2
# Pre-renders en paralelo (voz, Whisper, stock, IA). Casi no usan CPU: el
# limite real son los rate limits de las APIs externas.
PRE_RENDER_CONCURRENCY=3

# --- Render (ffmpeg) ---------------------------------------------------------
# Preset de x264 de la pasada final: "fast" tarda ~la mitad que "medium" y a
# 720p no se nota la diferencia.
RENDER_FINAL_PRESET=fast
# Tandas que se fusionan por comando al armar las transiciones. 2 = arbol
# binario (pensado para 4GB de RAM). Con 64GB, 8 baja de ~6 a ~2 los
# re-encodes completos del video.
RENDER_MERGE_FANIN=8
# Segmentos por tanda de ffmpeg (default 4, pensado para 4GB de RAM).
RENDER_BATCH_SIZE=6
# Descargas de clips en paralelo por tanda.
RENDER_DOWNLOAD_CONCURRENCY=6
# Tope por descarga (ms). Clips de stock pesados (4K) pueden necesitar mas
# que el default de 60s.
RENDER_DOWNLOAD_TIMEOUT_MS=180000

# --- Reintentos --------------------------------------------------------------
# Intentos del render (es idempotente, se reintenta solo).
RENDER_MAX_ATTEMPTS=3
# El pre-render NO se reintenta por default: repetirlo cobra de nuevo TTS,
# Whisper y video IA.
PRE_RENDER_MAX_ATTEMPTS=1

# --- Avanzado (normalmente no hace falta tocar) ------------------------------
# WORKER_POLL_INTERVAL_MS=3000
# WORKER_HEARTBEAT_INTERVAL_MS=30000
# WORKER_STALE_JOB_SECONDS=300
# WORKER_STALE_CHECK_INTERVAL_MS=60000
# WORKER_RETRY_DELAY_SECONDS=30
# WORKER_SHUTDOWN_GRACE_MS=840000
