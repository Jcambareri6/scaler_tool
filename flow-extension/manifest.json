{
  "manifest_version": 3,
  "name": "Scaler Tool → Flow",
  "version": "1.3.2",
  "description": "Manda los prompts de cada escena a Google Flow uno tras otro y descarga las imágenes en 720p o 1080p, numeradas por escena.",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "tabs",
    "debugger",
    "sidePanel",
    "unlimitedStorage"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "flow-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Scaler Tool → Flow"
  }
}
