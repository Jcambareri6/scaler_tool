{
  "manifest_version": 3,
  "name": "Scaler Tool → Flow",
  "version": "0.1.0",
  "description": "Manda los prompts de cada escena a Google Flow, espera la imagen y la carga sola en su escena de Scaler Tool.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Scaler Tool → Flow" }
}
